{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SD Prompt Viewer",
  "version": "1.0.1",
  "identifier": "com.azyu.sd-prompt-viewer",
  "build": {
    "beforeDevCommand": "npm run prepare-assets",
    "beforeBuildCommand": "npm run prepare-assets",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "SD Prompt Viewer",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0f172a",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
